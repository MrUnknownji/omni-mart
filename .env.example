# OmniMart Environment Configuration Example
# Copy this file to .env.local and replace with your own values, or use the Admin Settings page in the app.

# MongoDB Connection String (e.g., mongodb+srv://user:pass@cluster.mongodb.net/omnimart)
MONGO_URI=mongodb+srv://temporary_user:temporary_password@cluster0.example.mongodb.net/omnimart

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: JWT Secret for authentication
JWT_SECRET=temporary_secret_key_change_me_in_production
